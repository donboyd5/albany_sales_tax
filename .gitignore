# --- cached raw pulls ---
# Small cached JSON/CSV pulls ARE tracked so the build is reproducible offline.
# Large binary source files are not; MANIFEST.csv records their provenance.
data/raw/*.xlsx
data/raw/*.zip
data/raw/*.pdf
data/raw/large/
