# --- secrets ---
.Renviron

# --- R session cruft ---
.Rhistory
.RData
.Ruserdata
.Rproj.user
*.Rproj

# --- quarto ---
_output/
/.quarto/
**/_freeze/

# --- renv ---
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
